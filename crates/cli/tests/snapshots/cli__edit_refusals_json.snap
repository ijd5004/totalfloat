        "message": "no WBS node has the code NOWBS",
        "hint": "`query --columns code,wbs` shows WBS codes"
      },
      {
        "edit": 2,
        "source": "--duration A9=2d",
        "code": "no-such-activity",
        "message": "no project holds A9",
        "hint": "did you mean A1 or A2? use Activity IDs from `query`; a link to another project names it PROJECT:CODE"
      },
      {
        "edit": 3,
        "source": "--name A3=x",
        "code": "no-such-activity",
        "message": "no project holds A3",
        "hint": "did you mean A1 or A2? use Activity IDs from `query`; a link to another project names it PROJECT:CODE"
      },
      {
        "edit": 4,
        "source": "--link A1>B1",
        "code": "no-such-activity",
        "message": "no activity has the ID B1",
        "hint": "use the Activity ID, as `query` shows it in `code`; a link to another project names it PROJECT:CODE",
        "depends_on": 1
      }
    ]
  }
