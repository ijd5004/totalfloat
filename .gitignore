/corpus/files/

# Local agent state
.claude/settings.local.json

# Web app (ui/): dependencies and the build, which `cargo xtask ui` makes
/ui/node_modules/
/ui/dist/
# Types generated from docs/schemas/ by `pnpm gen`
/ui/src/api/schemas/

# playwright-cli snapshots and logs from browser checks
.playwright-cli/
