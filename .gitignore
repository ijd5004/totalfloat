# Rust
/target/
**/*.rs.bk

# Editors / OS
.idea/
.vscode/
*.swp
.DS_Store

# Real schedules must never be committed (CONTRIBUTING.md, Clean room).
# Only synthetic or permissioned fixtures, listed in a MANIFEST.md, are allowed.
*.xer
*.XER
*.mpp
*.MPP
!fixtures/**/*.xer
!crates/**/tests/fixtures/**/*.xer

